FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends pandoc && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml .
COPY src ./src
RUN pip install --no-cache-dir '.[kiosque]'
COPY config ./config
RUN mkdir -p data secrets
EXPOSE 8000
CMD ["uvicorn","lemonde_full_rss.main:app","--host","0.0.0.0","--port","8000"]
